<view class="custom-tabbar">
  <view
    wx:for="{{items}}"
    wx:key="path"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    role="button"
    aria-label="{{item.text}}"
  >
    <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>
