.start-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 66rpx) 36rpx
    calc(32rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 84% 10%, rgba(22, 122, 80, 0.1), transparent 30%),
    var(--canvas);
}

.start-content {
  width: 100%;
  max-width: 686rpx;
  margin: 0 auto;
}

.brand-mark {
  position: relative;
  width: 114rpx;
  height: 114rpx;
  margin-bottom: 26rpx;
  border-radius: 36rpx;
  background: var(--brand-soft);
  overflow: hidden;
}

.brand-pill {
  position: absolute;
  top: 42rpx;
  width: 62rpx;
  height: 28rpx;
  border-radius: 24rpx;
  transform: rotate(-38deg);
}

.brand-pill-left {
  left: 9rpx;
  background: var(--brand);
}

.brand-pill-right {
  right: 9rpx;
  background: #fff;
  border: 3rpx solid var(--brand);
}

.brand-name {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1.15;
}

.brand-line {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 28rpx;
}

.consent-card,
.status-card {
  margin-top: 52rpx;
  padding: 42rpx 34rpx 30rpx;
}

.consent-kicker {
  margin-bottom: 14rpx;
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.consent-title,
.status-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.consent-copy,
.status-copy {
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.promise-list {
  margin: 30rpx 0 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: var(--brand-soft);
}

.promise-row {
  display: flex;
  align-items: flex-start;
  color: var(--brand-deep);
  font-size: 24rpx;
  line-height: 1.8;
}

.promise-row + .promise-row {
  margin-top: 12rpx;
}

.promise-icon {
  display: inline-flex;
  width: 34rpx;
  flex-shrink: 0;
  font-weight: 800;
}

.consent-check {
  display: flex;
  min-height: 88rpx;
  align-items: flex-start;
  padding: 18rpx 0 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.consent-check checkbox {
  margin: 3rpx 18rpx 0 0;
  transform: scale(1.08);
}

.policy-button,
.plain-button,
.decline-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.2;
}

.policy-button {
  display: flex;
  min-height: 72rpx;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 2rpx;
  padding: 0;
  text-align: left;
}

.policy-arrow {
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1;
}

.start-primary,
.start-secondary {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.start-primary {
  margin-top: 30rpx;
  color: #fff;
  background: linear-gradient(100deg, #178653, #0f7148);
  box-shadow: 0 14rpx 30rpx rgba(22, 122, 80, 0.18);
}

.start-primary[disabled] {
  opacity: 0.42;
}

.start-secondary {
  margin-top: 18rpx;
  border: 1rpx solid #dfe6df;
  color: var(--brand-deep);
  background: rgba(255, 255, 255, 0.78);
  box-shadow: none;
}

.decline-button {
  margin-top: 8rpx;
  color: var(--muted);
  font-weight: 500;
}

.compact-button {
  margin-top: 28rpx;
}

.status-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.loading-dot {
  width: 30rpx;
  height: 30rpx;
  margin: 4rpx 0 24rpx;
  border: 5rpx solid var(--brand-soft);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.start-foot {
  max-width: 686rpx;
  margin: 32rpx auto 0;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.start-page {
  padding-top: 0;
}
