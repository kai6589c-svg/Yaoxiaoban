.settings-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.settings-subtitle {
  margin: 3rpx 0 30rpx;
  color: var(--muted);
  font-size: calc(23rpx * var(--text-scale, 1));
  text-align: center;
}

.demo-banner {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid #e1c986;
  border-radius: 20rpx;
  background: #fff8df;
  color: #6f5716;
  font-size: calc(26rpx * var(--text-scale, 1));
  line-height: 1.55;
}

.loading-card {
  padding: 64rpx 32rpx;
  color: var(--muted);
  text-align: center;
}

.settings-card {
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
}

.settings-section-title {
  padding: 24rpx 0 6rpx;
  color: var(--brand-deep);
  font-size: calc(25rpx * var(--text-scale, 1));
  font-weight: 750;
}

.settings-row {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  gap: 17rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
  text-align: left;
}

.row-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: var(--brand-soft);
}

.row-icon image {
  width: 33rpx;
  height: 33rpx;
}

.danger-icon {
  background: var(--danger-soft);
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row.disabled {
  opacity: 0.55;
}

.row-main {
  min-width: 0;
  flex: 1;
}

.row-title {
  color: var(--ink);
  font-size: calc(24rpx * var(--text-scale, 1));
  font-weight: 650;
  line-height: 1.4;
}

.row-copy {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: calc(20rpx * var(--text-scale, 1));
  line-height: 1.4;
}

.row-value {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: var(--brand-deep);
  color: var(--muted);
  font-size: calc(22rpx * var(--text-scale, 1));
  font-weight: 650;
}

.row-arrow {
  width: 30rpx;
  margin-left: 10rpx;
  color: #89918a;
  font-size: calc(38rpx * var(--text-scale, 1));
  line-height: 1;
  text-align: right;
}

.settings-row switch {
  flex-shrink: 0;
  margin-left: 20rpx;
  transform: scale(0.84);
  transform-origin: right center;
}

.section-note {
  padding: 14rpx 16rpx 0;
  color: var(--muted);
  font-size: calc(22rpx * var(--text-scale, 1));
  line-height: 1.55;
}

.danger-heading,
.danger-row .row-title {
  color: var(--danger);
}

.settings-foot {
  margin-top: 34rpx;
  padding: 0 16rpx;
  color: var(--muted);
  font-size: calc(22rpx * var(--text-scale, 1));
  line-height: 1.65;
  text-align: center;
}

.settings-foot view + view {
  margin-top: 8rpx;
}

.modal-backdrop {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-top: 80rpx;
  background: rgba(15, 26, 19, 0.55);
}

.delete-sheet {
  width: 100%;
  max-height: calc(100vh - 80rpx);
  padding: 38rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--surface);
  overflow-y: auto;
}

.delete-kicker {
  color: var(--danger);
  font-size: calc(26rpx * var(--text-scale, 1));
  font-weight: 700;
}

.delete-title {
  margin-top: 10rpx;
  font-size: calc(38rpx * var(--text-scale, 1));
  font-weight: 760;
}

.delete-copy {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: calc(27rpx * var(--text-scale, 1));
  line-height: 1.7;
}

.calendar-warning {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: var(--warning-soft);
}

.warning-title {
  color: #724100;
  font-size: calc(28rpx * var(--text-scale, 1));
  font-weight: 700;
}

.warning-copy {
  margin-top: 8rpx;
  color: #724100;
  font-size: calc(26rpx * var(--text-scale, 1));
  line-height: 1.6;
}

.acknowledge-row {
  display: flex;
  min-height: 88rpx;
  align-items: flex-start;
  padding-top: 18rpx;
  color: #5f3600;
  font-size: calc(26rpx * var(--text-scale, 1));
  line-height: 1.55;
}

.acknowledge-row checkbox {
  margin: 3rpx 16rpx 0 0;
}

.delete-input {
  height: 98rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d6dcd7;
  border-radius: 22rpx;
  background: #fafbf9;
  font-size: calc(30rpx * var(--text-scale, 1));
}

.delete-input:focus {
  border-color: var(--danger);
}

.sheet-button {
  margin-top: 30rpx;
}

.sheet-button[disabled] {
  opacity: 0.45;
}

.sheet-cancel {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: calc(28rpx * var(--text-scale, 1));
}
