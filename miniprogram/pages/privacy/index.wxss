.privacy-page {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.policy-head {
  padding: 20rpx 4rpx 34rpx;
}

.policy-kicker {
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}

.policy-title {
  margin-top: 10rpx;
  font-size: 54rpx;
  font-weight: 790;
  letter-spacing: -1rpx;
}

.policy-meta {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.summary-card {
  padding: 30rpx 28rpx;
  background: var(--brand-soft);
  box-shadow: none;
}

.summary-title {
  margin-bottom: 18rpx;
  color: var(--brand-deep);
  font-size: 32rpx;
  font-weight: 750;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  color: var(--brand-deep);
  font-size: 27rpx;
  line-height: 1.7;
}

.summary-row + .summary-row {
  margin-top: 10rpx;
}

.summary-mark {
  width: 36rpx;
  flex-shrink: 0;
  font-weight: 800;
}

.policy-section {
  position: relative;
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(20, 54, 36, 0.06);
  border-radius: var(--radius);
  background: var(--surface);
}

.section-number {
  margin-bottom: 10rpx;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.policy-heading {
  margin-bottom: 20rpx;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.4;
}

.policy-subheading {
  margin: 26rpx 0 10rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.5;
}

.policy-paragraph,
.bullet-row {
  color: #4f5851;
  font-size: 27rpx;
  line-height: 1.9;
  text-align: justify;
}

.paragraph-gap {
  margin-top: 18rpx;
}

.bullet-row {
  display: flex;
  align-items: flex-start;
}

.bullet-row + .bullet-row {
  margin-top: 8rpx;
}

.bullet {
  width: 30rpx;
  flex-shrink: 0;
  color: var(--brand);
  font-weight: 800;
}

.medical-note {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: var(--radius);
  color: #704200;
  background: var(--warning-soft);
  font-size: 27rpx;
  line-height: 1.75;
}

.medical-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.back-button {
  margin-top: 34rpx;
}
