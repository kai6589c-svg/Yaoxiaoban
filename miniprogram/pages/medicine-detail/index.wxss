.detail-page {
  --radius: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.loading-copy {
  padding: 120rpx 0;
  color: var(--muted);
  text-align: center;
}

.detail-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.expiry-alert {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 25rpx 26rpx;
  border-color: rgba(182, 61, 61, 0.14);
  background: #fff5f3;
}

.expiry-alert-icon {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: var(--danger-soft);
}

.expiry-alert-icon image {
  width: 34rpx;
  height: 34rpx;
}

.expiry-alert-body {
  min-width: 0;
  flex: 1;
}

.expiry-alert-title {
  color: var(--danger);
  font-size: calc(26rpx * var(--text-scale, 1));
  font-weight: 750;
}

.expiry-alert-copy {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: calc(21rpx * var(--text-scale, 1));
  line-height: 1.55;
}

.expiry-alert-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 17rpx;
}

.expiry-alert-button {
  display: flex;
  min-height: 58rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  font-size: calc(21rpx * var(--text-scale, 1));
  font-weight: 700;
}

.expiry-alert-button.danger {
  color: #fff;
  background: var(--danger);
}

.medicine-hero-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--brand-soft);
}

.medicine-hero-icon image {
  width: 61rpx;
  height: 61rpx;
}

.detail-identity {
  min-width: 0;
  flex: 1;
}

.detail-name {
  overflow: hidden;
  font-size: calc(34rpx * var(--text-scale, 1));
  font-weight: 750;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-profile {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: calc(23rpx * var(--text-scale, 1));
}

.edit-button {
  display: flex;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 6rpx;
  border: 1rpx solid var(--brand);
  border-radius: 20rpx;
  color: var(--brand-deep);
  background: #fff;
  font-size: calc(24rpx * var(--text-scale, 1));
  font-weight: 700;
  white-space: nowrap;
}

.summary-card,
.inventory-card,
.plan-card,
.action-list {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.summary-label {
  font-size: calc(32rpx * var(--text-scale, 1));
  font-weight: 650;
}

.summary-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.summary-value {
  color: var(--brand-deep);
  font-size: calc(60rpx * var(--text-scale, 1));
  font-weight: 700;
}

.summary-depletion {
  max-width: 48%;
  color: var(--muted);
  font-size: calc(22rpx * var(--text-scale, 1));
  text-align: right;
}

.estimate-basis,
.info-hint {
  color: var(--muted);
  font-size: calc(21rpx * var(--text-scale, 1));
  line-height: 1.55;
}

.estimate-basis {
  margin-top: 17rpx;
}

.section-action,
.expiry-link {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  text-align: left;
}

.expiry-status {
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  font-size: calc(19rpx * var(--text-scale, 1));
  font-weight: 700;
}

.expiry-status.warning {
  color: var(--warning);
  background: var(--warning-soft);
}

.expiry-status.danger {
  color: var(--danger);
  background: var(--danger-soft);
}

.section-action {
  min-height: 96rpx;
  border-top: 1rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  margin: 20rpx 0 -16rpx !important;
  padding: 8rpx 0 !important;
  max-width: none;
}

.section-card-title {
  font-size: calc(32rpx * var(--text-scale, 1));
  font-weight: 650;
  line-height: 1.4;
}

.section-arrow {
  color: #8f9791;
  font-size: calc(38rpx * var(--text-scale, 1));
  font-weight: 400;
}

.expiry-link {
  margin-top: 0;
  gap: 16rpx;
  flex-wrap: wrap;
  color: var(--ink);
  font-size: calc(30rpx * var(--text-scale, 1));
  font-weight: 600;
}

.expiry-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f5f8f5;
}

.expiry-column + .expiry-column {
  padding-left: 22rpx;
  border-left: 1rpx solid #d7e0d9;
}

.expiry-label {
  color: var(--muted);
  font-size: calc(20rpx * var(--text-scale, 1));
}

.expiry-value {
  margin-top: 8rpx;
  font-size: calc(28rpx * var(--text-scale, 1));
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.expiry-hint {
  margin-top: 13rpx;
}

.feature-row {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.feature-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.feature-icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: var(--brand-soft);
}

.feature-icon image {
  width: 30rpx;
  height: 30rpx;
}

.feature-body {
  min-width: 0;
  flex: 1;
}

.feature-title {
  font-size: calc(23rpx * var(--text-scale, 1));
  font-weight: 650;
  line-height: 1.4;
}

.feature-copy {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: calc(20rpx * var(--text-scale, 1));
  line-height: 1.4;
}

.row-link {
  max-width: 180rpx;
  flex-shrink: 0;
  color: var(--brand-deep);
  font-size: calc(21rpx * var(--text-scale, 1));
  font-weight: 650;
  text-align: right;
  line-height: 1.35;
}

.calendar-card.warning {
  background: #fffaf1;
}

.note-card {
  margin: -2rpx 0 20rpx;
  padding: 26rpx 28rpx;
  font-size: calc(24rpx * var(--text-scale, 1));
  line-height: 1.65;
}

.detail-page > .section-title {
  margin: 30rpx 0 14rpx;
  font-size: calc(25rpx * var(--text-scale, 1));
}

.action-list .section-card-title {
  margin-bottom: 8rpx;
}

.list-action {
  display: grid;
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 0;
  align-items: center;
  grid-template-columns: 54rpx 1fr 32rpx;
  column-gap: 16rpx;
  border-bottom: 1rpx solid var(--line);
  text-align: left;
  font-size: calc(28rpx * var(--text-scale, 1));
}

.list-action:last-child {
  border-bottom: 0;
}

.list-action.disabled {
  opacity: 0.45;
}

.archive-button {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  text-align: left;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid #cfe1d6;
  border-radius: 24rpx;
  color: var(--brand-deep);
  background: #f3f7f3;
  font-size: calc(24rpx * var(--text-scale, 1));
}

.archive-button image {
  width: 30rpx;
  height: 30rpx;
}

.delete-button {
  display: flex;
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 8rpx;
  text-align: left;
  gap: 16rpx;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 0;
  color: var(--danger);
  font-size: calc(21rpx * var(--text-scale, 1));
}

.detail-photo {
  width: 132rpx;
  flex-shrink: 0;
  text-align: center;
  color: var(--brand-deep);
  font-size: calc(20rpx * var(--text-scale, 1));
}
.detail-photo image {
  display: block;
  width: 132rpx;
  height: 132rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}
.photo-saved {
  color: var(--brand-deep);
  font-size: calc(21rpx * var(--text-scale, 1));
  margin-bottom: 6rpx;
}
.saved-notice,
.usage-card,
.old-calendar-note {
  padding: 26rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.saved-notice {
  background: var(--brand-soft);
}
.old-calendar-note {
  background: var(--warning-soft);
  color: var(--warning);
  font-size: calc(24rpx * var(--text-scale, 1));
}
.usage-row,
.usage-field,
.usage-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
}
.usage-row {
  border-bottom: 1rpx solid var(--line);
  font-size: calc(24rpx * var(--text-scale, 1));
}
.usage-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}
.usage-sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 48rpx 48rpx 0 0;
  background: var(--page, #f7f8f3);
  box-sizing: border-box;
}
.usage-field {
  border-bottom: 1rpx solid var(--line);
  font-size: calc(28rpx * var(--text-scale, 1));
}
.usage-field input {
  width: 220rpx;
  text-align: right;
}
.usage-actions button {
  flex: 1;
}
.usage-error {
  color: var(--danger);
  margin-top: 20rpx;
}

.detail-name,
.detail-profile,
.feature-title,
.usage-row text {
  white-space: normal;
  overflow-wrap: anywhere;
}
.detail-head,
.feature-row {
  flex-wrap: wrap;
}
.detail-identity,
.feature-body {
  min-width: 180rpx;
}
@media (max-width: 360px) {
  .expiry-panel {
    grid-template-columns: minmax(0, 1fr);
    gap: 20rpx;
  }
  .expiry-column + .expiry-column {
    border-left: 0;
    border-top: 1rpx solid var(--line);
    padding: 16rpx 0 0;
  }
}

.detail-page .card {
  box-shadow: none;
  border-color: rgba(20, 54, 36, 0.035);
}
.detail-page .feature-copy {
  font-size: calc(24rpx * var(--text-scale, 1));
  line-height: 1.5;
}
.detail-name {
  overflow: visible;
  text-overflow: clip;
  font-size: calc(36rpx * var(--text-scale, 1));
  line-height: 1.4;
}
.stock-primary {
  min-width: 0;
}
.stock-caption {
  color: var(--muted);
  font-size: calc(24rpx * var(--text-scale, 1));
  margin-top: 2rpx;
}
.shortage-date {
  font-size: calc(30rpx * var(--text-scale, 1));
  font-weight: 600;
  margin-bottom: 4rpx;
}
.summary-main.warning .summary-depletion {
  color: var(--warning);
}
.summary-main.danger .summary-depletion,
.summary-main.danger .summary-value {
  color: var(--danger);
}
.summary-main.normal .shortage-date {
  color: var(--brand-deep);
}
.estimate-basis {
  font-size: calc(24rpx * var(--text-scale, 1));
  line-height: 1.7;
}
.section-action .section-card-title {
  font-size: calc(28rpx * var(--text-scale, 1));
  font-weight: 600;
}
.expiry-status {
  background: #eff5f0;
  font-size: calc(22rpx * var(--text-scale, 1));
  border-radius: 16rpx;
  font-weight: 500;
}
.expiry-meta {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 14rpx;
  font-size: calc(23rpx * var(--text-scale, 1));
}
.expiry-meta > text:last-child {
  color: var(--muted);
  overflow-wrap: anywhere;
}
.usage-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.usage-record {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-width: 100rpx;
  min-height: 88rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 8rpx;
  color: var(--brand-deep);
  font-size: calc(28rpx * var(--text-scale, 1));
  background: transparent;
  border-radius: 24rpx;
}
.usage-record[disabled],
.archive-button[disabled],
.delete-button[disabled] {
  opacity: 0.45;
}
.row-link {
  min-height: 88rpx;
  padding: 12rpx 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.danger-zone {
  margin-top: 32rpx;
  padding: 0 8rpx;
}
.danger-section-label {
  margin-bottom: 16rpx;
  color: var(--muted);
  font-size: calc(24rpx * var(--text-scale, 1));
}
.delete-button {
  justify-content: space-between;
  font-size: calc(26rpx * var(--text-scale, 1));
}
.delete-button .section-arrow {
  color: var(--danger);
}
.danger-zone .feature-copy {
  font-size: calc(23rpx * var(--text-scale, 1));
  font-weight: 400;
  color: var(--muted);
}
.detail-pressed {
  background: #edf3ee !important;
}
.danger-pressed {
  background: var(--danger-soft);
}
.usage-backdrop .primary-button {
  box-shadow: none;
  border-radius: 24rpx;
}
.archive-button,
.delete-button,
.section-action {
  width: 100% !important;
  max-width: none;
}
.usage-record,
.row-link {
  width: auto !important;
  max-width: none;
}

.reminder-health {
  margin: 24rpx 32rpx 40rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #eef6f0;
  line-height: 1.6;
}
.reminder-health.warning {
  background: #fff3dd;
}
.health-title {
  font-weight: 700;
}
.health-detail {
  margin-top: 12rpx;
  color: #52665d;
  font-size: 26rpx;
}
