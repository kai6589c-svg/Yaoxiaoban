.profiles-page {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.profiles-page .text-button {
  min-height: 88rpx;
}

.privacy-note {
  margin-bottom: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  font-size: 24rpx;
  line-height: 1.55;
}

.loading-card {
  padding: 64rpx 32rpx;
  color: var(--muted);
  text-align: center;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.profile-card {
  padding: 24rpx 26rpx 12rpx;
}

.profile-main {
  display: flex;
  min-height: 92rpx;
  align-items: center;
}

.profile-avatar {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 750;
}

.profile-copy {
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.profile-meta {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.profile-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
  border-top: 1rpx solid var(--line);
}

.profile-action {
  display: flex;
  min-width: 112rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 650;
}

.profile-action[disabled] {
  color: #a8ada9;
}

.archive-action {
  color: var(--muted);
}

.archived-card {
  padding: 0 26rpx;
}

.archived-row {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
}

.archived-row:last-child {
  border-bottom: 0;
}

.archived-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  opacity: 0.6;
}

.archived-name {
  margin-left: 18rpx;
  flex: 1;
  color: var(--muted);
  font-size: 28rpx;
}

.archived-state {
  color: #8c938d;
  font-size: 26rpx;
}

.modal-backdrop {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-top: 50rpx;
  background: rgba(15, 26, 19, 0.55);
}

.editor-sheet {
  width: 100%;
  max-height: calc(100vh - 50rpx);
  padding: 38rpx 32rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--surface);
  overflow-y: auto;
}

.sheet-kicker {
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}

.sheet-title {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 760;
}

.field-label {
  margin: 30rpx 0 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 650;
}

.name-input {
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d8ded9;
  border-radius: 22rpx;
  background: #fafbf9;
  font-size: 30rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.relation-chip {
  display: flex;
  min-width: 104rpx;
  min-height: 82rpx;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  color: var(--muted);
  background: #fff;
  font-size: 27rpx;
}

.relation-chip.selected {
  border-color: var(--brand);
  color: var(--brand-deep);
  background: var(--brand-soft);
  font-weight: 700;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-option {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #fff;
  border-radius: 30rpx;
  box-shadow: 0 0 0 2rpx var(--line);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.color-option.selected {
  box-shadow: 0 0 0 4rpx var(--ink);
}

.authorization-row {
  display: flex;
  min-height: 100rpx;
  align-items: flex-start;
  margin-top: 30rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  font-size: 26rpx;
  line-height: 1.6;
}

.authorization-row checkbox {
  margin: 3rpx 16rpx 0 0;
}

.form-error {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: var(--danger);
  background: var(--danger-soft);
  font-size: 26rpx;
  line-height: 1.5;
}

.save-button {
  margin-top: 30rpx;
}

.sheet-cancel {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 28rpx;
}
