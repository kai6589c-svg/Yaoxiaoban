:host {
  display: block;
  position: sticky;
  top: 0;
  z-index: 100;
}

.app-nav {
  position: sticky;
  z-index: 100;
  top: 0;
  width: calc(100% + 72rpx);
  box-sizing: border-box;
  min-height: calc(env(safe-area-inset-top) + 100rpx);
  margin: 0 -36rpx 40rpx;
  padding: env(safe-area-inset-top) 24rpx 0;
  border-bottom: 1rpx solid rgba(229, 233, 227, 0.82);
  background: rgba(247, 248, 243, 0.97);
}

.app-nav-row {
  position: relative;
  display: flex;
  min-height: 100rpx;
  align-items: center;
}

.app-nav-back {
  display: flex;
  box-sizing: border-box;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 80rpx;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  color: #17201b;
  background: transparent;
  font-size: 54rpx;
  font-weight: 400;
  line-height: 1;
  text-align: left;
}

.app-nav-back-active {
  opacity: 0.55;
}

.app-nav-title {
  position: absolute;
  right: 100rpx;
  left: 100rpx;
  overflow: hidden;
  color: #17201b;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    sans-serif;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-nav-spacer {
  width: 100rpx;
}

.spacer-only {
  margin-bottom: 20rpx;
  border: 0;
}
